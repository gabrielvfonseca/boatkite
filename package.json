{
  "name": "boatkite",
  "version": "0.1.0",
  "description": "Open-source autoscaler that runs Buildkite jobs on boat.dev VMs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "boatkite": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js run",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "version": "node scripts/release.mjs"
  },
  "lint-staged": {
    "*": ["biome check --write ."]
  },
  "keywords": ["buildkite", "boat", "ci", "autoscaler"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@boatdev/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
